.pytest_cache/
.coverage
htmlcov/
test_*.py
tests/

# Local database backups & uploads
database_backup*/
database_backup_*
uploads/*
!uploads/.gitkeep
scratch/
.user_uploaded/

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Operating system and editor artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
